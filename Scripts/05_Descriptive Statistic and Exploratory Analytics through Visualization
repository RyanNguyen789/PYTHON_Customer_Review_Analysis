print(df.describe())


# Scatter plot with reviewer location against overall rating
#Perhaps some relationship between how many contributers a person submits and the overall rating

plt.scatter(df['contributions'], df['overallRating'])
 
# Adding Title to the Plot
plt.title("Scatter Plot")
 
# Setting the X and Y labels
plt.xlabel('contributions')
plt.ylabel('overallRating')
 
plt.show()



